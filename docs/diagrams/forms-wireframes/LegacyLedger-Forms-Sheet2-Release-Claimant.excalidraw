      "versionNonce": 4595,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "1. Blocks erasure if an active claim workflow or legal retention basis still applies.",
      "fontSize": 11.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Blocks erasure if an active claim workflow or legal retention basis still applies.",
      "lineHeight": 1.25
    },
    {
      "id": "text_149",
      "type": "text",
      "x": 860,
      "y": 903,
      "width": 541,
      "height": 15,
      "angle": 0,
