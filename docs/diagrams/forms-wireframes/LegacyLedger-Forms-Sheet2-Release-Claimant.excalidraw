      "versionNonce": 4626,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "2. Audit log records pseudonymous actor_ref and outcome without storing raw PII.",
      "fontSize": 11.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Audit log records pseudonymous actor_ref and outcome without storing raw PII.",
