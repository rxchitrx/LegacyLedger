      "locked": false,
      "text": "1. Client/API: Rejects blank username or password before database lookup.",
      "fontSize": 11.5,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Client/API: Rejects blank username or password before database lookup.",
      "lineHeight": 1.25
    },
