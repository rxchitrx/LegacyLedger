      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "FD1 starts from the primary key. FD2 starts from the documented alternate key.",
      "roughness": 1,
      "roundness": null,
      "seed": 574290060,
      "strokeColor": "#000000",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "FD1 starts from the primary key. FD2 starts from the documented alternate key.",
