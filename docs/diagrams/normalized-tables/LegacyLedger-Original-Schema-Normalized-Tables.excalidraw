      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "ASSET_TRUST contains only its composite key, so it has no nontrivial dependency to draw.",
      "roughness": 1,
      "roundness": null,
      "seed": 574290060,
      "strokeColor": "#000000",
      "strokeStyle": "solid",
