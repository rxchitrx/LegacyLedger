      "versionNonce": 8935,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "1. 1NF / 2NF / 3NF / BCNF Verified across all 22 PostgreSQL relations:",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 1NF / 2NF / 3NF / BCNF Verified across all 22 PostgreSQL relations:",
      "lineHeight": 1.2
    },
    {
      "id": "text_289",
      "type": "text",
      "x": 1470,
      "y": 1217,
      "width": 690,
      "height": 16,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 5014,
      "version": 1,
      "versionNonce": 8966,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "   - All M:N relationships resolved via junction tables (DESIGNATION, OWNERSHIP_SHARE, NOMINATION,",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   - All M:N relationships resolved via junction tables (DESIGNATION, OWNERSHIP_SHARE, NOMINATION,",
      "lineHeight": 1.2
    },
    {
      "id": "text_290",
      "type": "text",
      "x": 1470,
      "y": 1240,
      "width": 606,
      "height": 16,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 5031,
      "version": 1,
      "versionNonce": 8997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "     DOCUMENT_ASSET, WORKFLOW_PERMISSION, RULE_SOURCE) with zero partial dependencies.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "     DOCUMENT_ASSET, WORKFLOW_PERMISSION, RULE_SOURCE) with zero partial dependencies.",
      "lineHeight": 1.2
    },
    {
      "id": "text_291",
      "type": "text",
      "x": 1470,
      "y": 1263,
      "width": 655,
      "height": 16,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 5048,
      "version": 1,
      "versionNonce": 9028,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "   - Zero transitive dependencies: owner_person_id stays in ESTATE_PROFILE (not DESIGNATION);",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "   - Zero transitive dependencies: owner_person_id stays in ESTATE_PROFILE (not DESIGNATION);",
